<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<RootNamespace>Typedown.WinUI</RootNamespace>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationIcon>Assets\logo.ico</ApplicationIcon>
		<Platforms>x64;x86;ARM64</Platforms>
		<UseWinUI>true</UseWinUI>
		<!-- Caret Portable: always unpackaged. No MSIX, no certificate, nothing to install; the build
		     output is a folder that runs from wherever it's copied. EnableMsixTooling stays on because the
		     Windows App SDK uses it to generate resources.pri for unpackaged apps too. -->
		<EnableMsixTooling>true</EnableMsixTooling>
		<WindowsPackageType>None</WindowsPackageType>
		<!-- The Windows App SDK runtime ships inside the folder, so the PC doesn't need it installed. -->
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<SelfContained>false</SelfContained>
		<AssemblyName>Caret</AssemblyName>
		<Product>Caret Portable</Product>
		<AssemblyTitle>Caret Portable</AssemblyTitle>
		<Company>Ferenc Works</Company>
		<Copyright>Copyright © 2026 Ferenc Works. Based on Typedown, copyright © 2022 ZZF.</Copyright>
		<Version>1.4.0</Version>
		<Nullable>disable</Nullable>
		<Configurations>Debug;Release;Debug_Local</Configurations>
		<!-- Turns off the WinUI 3 SDK-generated Program/Main (see the #if in the generated App.g.i.cs)
		     so Program.cs's own Main can run AppInstance single-instance redirection before an
		     Application or window ever gets created. -->
		<DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
	</PropertyGroup>

	<!-- Release is the portable build: the .NET runtime ships inside the folder too, so nothing at all
	     has to be installed on the PC (see build/package.ps1 and .github/workflows/portable.yml). -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<SelfContained>true</SelfContained>
		<DebugType>None</DebugType>
		<!-- Only the framework satellite assemblies for Caret's own languages, not dozens of folders. -->
		<SatelliteResourceLanguages>en;fr;es</SatelliteResourceLanguages>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Platform)' == 'x64'">
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Platform)' == 'x86'">
		<RuntimeIdentifier>win-x86</RuntimeIdentifier>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Platform)' == 'ARM64'">
		<RuntimeIdentifier>win-arm64</RuntimeIdentifier>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.250402" />
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250602001" />
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="System.Reactive" Version="6.0.1" />
		<PackageReference Include="PropertyChanged.Fody" Version="4.1.0" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<!-- The editor bundle. `yarn build` in src\Caret.Editor writes it here (config-overrides.js);
		     it's build output, so it's gitignored (Resources\.gitignore) and has to be built once first. -->
		<None Update="Resources\Statics\**" CopyToOutputDirectory="PreserveNewest" />
		<!-- Licence texts ship with the app (MIT requires the notice in copies). -->
		<!-- The window and title-bar icons, loaded from the output folder at run time (MainWindow). -->
		<Content Remove="Assets\**" />
		<Content Include="Assets\logo.ico;Assets\AppIcon.png" CopyToOutputDirectory="PreserveNewest" />
		<!-- Caret's MarkItDown email plugin (plugins/markitdown-email), loaded from here by the worker
		     (Services/MarkItDown/MarkItDownWorker.cs) without a pip install. -->
		<Content Include="..\..\plugins\markitdown-email\src\markitdown_caret_email\*.py" Link="markitdown-plugins\markitdown_caret_email\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="..\..\plugins\markitdown-email\src\markitdown_caret_email\rules\*.json" Link="markitdown-plugins\markitdown_caret_email\rules\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- Utilities/Locale.cs reads Strings\<lang>\*.resw as plain XML at runtime, but as PRIResource items
	     they were only compiled into resources.pri, never copied: the dev output's Strings\en was empty
	     and the MSIX had no Strings folder, so every Locale.GetString returned null (the editor's own UI
	     strings via GetStringResources included). A static <None>/<Content> item for them doesn't work —
	     the Windows App SDK targets strip any non-PRIResource item pointing at a .resw — so they're added
	     as content here, during the build, after that cleanup. -->
	<Target Name="CopyLocaleStringsToOutput" BeforeTargets="AssignTargetPaths">
		<ItemGroup>
			<Content Include="@(PRIResource)" Condition="'%(Extension)' == '.resw'" CopyToOutputDirectory="PreserveNewest" Link="%(Identity)" />
		</ItemGroup>
	</Target>

</Project>
