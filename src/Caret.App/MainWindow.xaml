<Window
    x:Class="Typedown.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Typedown.WinUI"
    xmlns:u="using:Typedown.WinUI.Utilities">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <!-- Background set explicitly: a plain Grid has no default fill (transparent), so without this
             the window shows raw black whenever Mica is off (Mica's translucent material is what was
             painting the window before — see SettingsViewModel.UseMicaEffect's default, now off by
             default so Caret's own flat brand background is what actually shows). Also lets the Mica
             backdrop (when a user turns it back on) tint blend over a consistent themed base instead
             of nothing.
             WinUI 3's Window has no Resources property (unlike WPF) — these live on the root Grid
             instead. Folder tree: New File/New Folder/Rename/Delete/Reveal, plus (now) Cut/Copy/
             Paste/Copy as Path and item-to-item drag-drop — see the DragStarting/DragOver/Drop
             handlers and the Cut/Copy/Paste region in MainWindow.xaml.cs. The flyout inherits its
             DataContext from whichever TreeViewItem it opened on, same as the original.
             RootContextFlyout is the TreeView's own background flyout (empty space, not any
             particular row) — ported from the original's separate TreeViewContextFlyout, since
             without it there's no way to create a file/paste into the top level of an opened folder
             at all (every other New File/New Folder/Paste is scoped to a specific row's folder). -->
        <Grid.Resources>
            <MenuFlyout x:Key="RootContextFlyout" Opening="RootContextFlyout_Opening">
                <MenuFlyoutItem Text="{u:Loc Key=NewFile}" Click="NewFileRootContext_Click"/>
                <MenuFlyoutItem Text="{u:Loc Key=NewFolder}" Click="NewFolderRootContext_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="{u:Loc Key=Paste}" Click="PasteRootContext_Click"/>
            </MenuFlyout>
            <MenuFlyout x:Key="FolderContextFlyout">
                <MenuFlyoutItem Text="{u:Loc Key=NewFile}" Click="NewFileContext_Click"/>
                <MenuFlyoutItem Text="{u:Loc Key=NewFolder}" Click="NewFolderContext_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="{u:Loc Key=Cut}" Click="CutContext_Click"/>
                <MenuFlyoutItem Text="{u:Loc Key=Copy}" Click="CopyContext_Click"/>
                <MenuFlyoutItem Text="{u:Loc Key=Paste}" Click="PasteContext_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="{u:Loc Key=CopyAsPath}" Click="CopyAsPathContext_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="{u:Loc Key=Rename}" Click="RenameContext_Click"/>
                <MenuFlyoutItem Text="{u:Loc Key=Delete}" Click="DeleteContext_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="{u:Loc Key=RevealInFileExplorer}" Click="RevealContext_Click"/>
            </MenuFlyout>
            <MenuFlyout x:Key="FileContextFlyout">
                <MenuFlyoutItem Text="{u:Loc Key=Open}" Click="OpenContext_Click"/>
                <MenuFlyoutItem Text="{u:Loc Key=OpenInNewWindow}" Click="OpenInNewWindowContext_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="{u:Loc Key=ToggleFavorite}" Click="FavoriteToggleContext_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="{u:Loc Key=Cut}" Click="CutContext_Click"/>
                <MenuFlyoutItem Text="{u:Loc Key=Copy}" Click="CopyContext_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="{u:Loc Key=CopyAsPath}" Click="CopyAsPathContext_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="{u:Loc Key=Rename}" Click="RenameContext_Click"/>
                <MenuFlyoutItem Text="{u:Loc Key=Delete}" Click="DeleteContext_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="{u:Loc Key=RevealInFileExplorer}" Click="RevealContext_Click"/>
            </MenuFlyout>
            <DataTemplate x:Key="FolderItemTemplate">
                <TreeViewItem ItemsSource="{Binding Children}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                              ContextFlyout="{StaticResource FolderContextFlyout}"
                              AutomationProperties.Name="{Binding Name}"
                              CanDrag="True" DragStarting="FolderTreeItem_DragStarting"
                              AllowDrop="True" DragOver="FolderTreeItem_DragOver" Drop="FolderTreeItem_Drop">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Data="M3 6H10L12 8H21V20H3Z" Style="{StaticResource CaretLineIconStyle}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </TreeViewItem>
            </DataTemplate>
            <DataTemplate x:Key="FileItemTemplate">
                <TreeViewItem ContextFlyout="{StaticResource FileContextFlyout}" IsSelected="{Binding IsSelected, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding Name}"
                              CanDrag="True" DragStarting="FolderTreeItem_DragStarting"
                              AllowDrop="True" DragOver="FolderTreeItem_DragOver" Drop="FolderTreeItem_Drop">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Data="M6 3H14L19 8V21H6Z M14 3V8H19" Style="{StaticResource CaretLineIconStyle}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </TreeViewItem>
            </DataTemplate>
            <local:ExplorerItemTemplateSelector x:Key="ExplorerItemTemplateSelector"
                FolderTemplate="{StaticResource FolderItemTemplate}" FileTemplate="{StaticResource FileItemTemplate}"/>

            <!-- Shared by the sidebar's Recent/Favorites/Templates panels (all backed by
                 Models.NavFileEntry — see NavListView_SelectionChanged's Refresh* methods) and by
                 Trash (backed by Services.TrashEntry, which already carries its own Name). -->
            <DataTemplate x:Key="NavFileEntryTemplate">
                <TextBlock Text="{Binding Name}" Margin="12,6" TextTrimming="CharacterEllipsis"
                           ToolTipService.ToolTip="{Binding FullPath}"/>
            </DataTemplate>
            <DataTemplate x:Key="TrashEntryTemplate">
                <StackPanel Margin="12,6">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding OriginalPath}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar: WinUI 3's native ExtendsContentIntoTitleBar + SetTitleBar, not a port
             of Caption.xaml (that used a private Typedown.XamlUI NuGet package for drag/caption-button
             handling we don't have source for, and a full AppViewModel we haven't built).
             Theme/Settings buttons (Phase 2 of the warm-autumn reskin, matching the mockups' top-bar
             icon row): plain Buttons placed directly inside the SetTitleBar element still work as
             ordinary clickable buttons, not drag handles — WinUI 3 detects interactive controls in a
             title bar and excludes them from the drag region automatically, no extra passthrough
             config needed. The 140px right margin keeps them clear of the OS-drawn caption buttons
             (minimize/maximize/close), which WinUI 3 reserves space for on its own. The search box and
             remaining icons (layout toggle) from the mockups aren't here yet — see docs/history.md. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="32">
            <!-- ExtendsContentIntoTitleBar hands the whole bar to app content — the OS draws no icon of
                 its own here (AppWindow.SetIcon only covers the taskbar/Alt-Tab), so the title bar's
                 icon has to be a plain Image like any other title bar content. VerticalAlignment="Top"
                 + a manual top margin, not "Center", is deliberate: with Center the Image silently
                 rendered nothing at all (confirmed with a debug Rectangle/Border in its place, size and
                 x-position weren't the cause) even though this same 32px-tall row centers the Buttons
                 to its right and the title TextBlock just fine — narrowed down to Center specifically
                 on an Image-shaped element here, root cause not fully understood, Top is the verified
                 workaround. -->
            <Image x:Name="TitleBarIconImage" Width="16" Height="16" HorizontalAlignment="Left"
                   VerticalAlignment="Top" Margin="12,8,0,0"/>
            <TextBlock x:Name="TitleTextBlock" Text="Caret" VerticalAlignment="Center" Margin="34,0,0,0"
                       Style="{ThemeResource CaptionTextBlockStyle}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,140,0" Spacing="4">
                <!-- View | Code | Split switch (the mockups' Preview/Split toggle). Three plain
                     ToggleButtons kept mutually exclusive in code (SetViewMode) — WinUI 3 has no
                     built-in segmented control in this SDK version. -->
                <StackPanel x:Name="ViewModeSwitch" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="6" Padding="2">
                    <ToggleButton x:Name="ViewModeViewButton" Content="{u:Loc Key=ViewModeViewButton_Content}" Tag="view" Click="ViewModeButton_Click"
                                  FontSize="12" Padding="10,2" MinHeight="24" BorderThickness="0" CornerRadius="4"
                                  ToolTipService.ToolTip="{u:Loc Key=ViewModeViewButton_ToolTip}"/>
                    <ToggleButton x:Name="ViewModeCodeButton" Content="{u:Loc Key=ViewModeCodeButton_Content}" Tag="code" Click="ViewModeButton_Click"
                                  FontSize="12" Padding="10,2" MinHeight="24" BorderThickness="0" CornerRadius="4"
                                  ToolTipService.ToolTip="{u:Loc Key=ViewModeCodeButton_ToolTip}"/>
                    <ToggleButton x:Name="ViewModeSplitButton" Content="{u:Loc Key=ViewModeSplitButton_Content}" Tag="split" Click="ViewModeButton_Click"
                                  FontSize="12" Padding="10,2" MinHeight="24" BorderThickness="0" CornerRadius="4"
                                  ToolTipService.ToolTip="{u:Loc Key=ViewModeSplitButton_ToolTip}"/>
                </StackPanel>
                <!-- Favorite the open file. Until now the only way was the folder tree's right-click
                     menu, which needs a folder open first — the Favorites panel was hard to discover.
                     Disabled for an unsaved Untitled document (favorites are file paths). -->
                <Button x:Name="FavoriteButton" Click="FavoriteButton_Click" Background="Transparent" BorderThickness="0"
                        Width="32" Height="32" Padding="0" IsEnabled="False" ToolTipService.ToolTip="{u:Loc Key=FavoriteButton_ToolTip}">
                    <Grid>
                        <Path x:Name="FavoriteOutlineIcon" Data="M12 3L14.8 8.7L21 9.6L16.5 14L17.6 20.2L12 17.3L6.4 20.2L7.5 14L3 9.6L9.2 8.7Z"
                              Style="{StaticResource CaretLineIconStyle}" Width="16" Height="16"/>
                        <Path x:Name="FavoriteFilledIcon" Visibility="Collapsed" Data="M12 3L14.8 8.7L21 9.6L16.5 14L17.6 20.2L12 17.3L6.4 20.2L7.5 14L3 9.6L9.2 8.7Z"
                              Style="{StaticResource CaretLineIconStyle}" Width="16" Height="16"
                              Fill="{ThemeResource CaretSecondaryBrush}" Stroke="{ThemeResource CaretSecondaryBrush}"/>
                    </Grid>
                </Button>
                <Button x:Name="QuickOpenButton" Click="QuickOpenButton_Click" Background="Transparent" BorderThickness="0"
                        Width="32" Height="32" Padding="0" ToolTipService.ToolTip="{u:Loc Key=QuickOpenButton_ToolTip}">
                    <Path Data="M10 4A6 6 0 1 0 10 16A6 6 0 0 0 10 4ZM14.5 14.5L20 20"
                          Style="{StaticResource CaretLineIconStyle}" Width="16" Height="16"/>
                </Button>
                <Button x:Name="ThemeToggleButton" Click="ThemeToggleButton_Click" Background="Transparent" BorderThickness="0"
                        Width="32" Height="32" Padding="0" ToolTipService.ToolTip="{u:Loc Key=ThemeToggleButton_ToolTip}">
                    <Grid>
                        <Path x:Name="SunIcon" Data="M12 4V2M12 22V20M4 12H2M22 12H20M5 5L3.5 3.5M20.5 20.5L19 19M19 5L20.5 3.5M5 19L3.5 20.5M12 7A5 5 0 1 0 12 17A5 5 0 0 0 12 7Z"
                              Style="{StaticResource CaretLineIconStyle}" Width="16" Height="16"/>
                        <Path x:Name="MoonIcon" Visibility="Collapsed" Data="M20 15.5A8 8 0 0 1 8.5 4A8 8 0 1 0 20 15.5Z"
                              Style="{StaticResource CaretLineIconStyle}" Width="16" Height="16"/>
                    </Grid>
                </Button>
                <Button x:Name="TitleSettingsButton" Click="SettingsMenuItem_Click" Background="Transparent" BorderThickness="0"
                        Width="32" Height="32" Padding="0" ToolTipService.ToolTip="{u:Loc Key=TitleSettingsButton_ToolTip}">
                    <Path Data="M12 8A4 4 0 1 0 12 16A4 4 0 0 0 12 8ZM19 13.5L21 15L19 18L16.8 17.2L15 18.2L14.5 21H9.5L9 18.2L7.2 17.2L5 18L3 15L5 13.5V10.5L3 9L5 6L7.2 6.8L9 5.8L9.5 3H14.5L15 5.8L16.8 6.8L19 6L21 9L19 10.5Z"
                          Style="{StaticResource CaretLineIconStyle}" Width="16" Height="16"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Reduced menu: only File actions that have a real, working implementation behind them
             (New/Open/Save/SaveAs/Exit), plus Find which drives the floating panel below.
             Paragraph/Format/View and most of Edit are deferred — they need EditorViewModel/
             UIViewModel ported first (more #2/#3 work). -->
        <MenuBar x:Name="AppMenuBar" Grid.Row="1">
            <MenuBarItem Title="{u:Loc Key=File}">
                <MenuFlyoutItem x:Name="NewMenuItem" Text="{u:Loc Key=NewMenuItem_Text}" Click="NewMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="OpenMenuItem" Text="{u:Loc Key=OpenMenuItem_Text}" Click="OpenMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="O" Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="OpenFolderMenuItem" Text="{u:Loc Key=OpenFolderMenuItem_Text}" Click="OpenFolderMenuItem_Click"/>
                <MenuFlyoutItem x:Name="QuickOpenMenuItem" Text="{u:Loc Key=QuickOpenMenuItem_Text}" Click="QuickOpenMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="K" Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="NewWindowMenuItem" Text="{u:Loc Key=NewWindowMenuItem_Text}" KeyboardAcceleratorTextOverride="{u:Loc Key=CtrlShiftN}" Click="NewWindowMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control,Shift"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSubItem x:Name="OpenRecentMenu" Text="{u:Loc Key=OpenRecentMenu_Text}">
                    <MenuFlyoutItem Text="{u:Loc Key=NoRecentFiles}" IsEnabled="False"/>
                </MenuFlyoutSubItem>
                <MenuFlyoutItem x:Name="ImportMarkItDownMenuItem" Text="{u:Loc Key=ImportMarkItDownMenuItem_Text}" Click="ImportMarkItDownMenuItem_Click"/>
                <MenuFlyoutItem Text="{u:Loc Key=ConvertMenuItem}" Click="HomeConvertButton_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem x:Name="SaveMenuItem" Text="{u:Loc Key=SaveMenuItem_Text}" Click="SaveMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="SaveAsMenuItem" Text="{u:Loc Key=SaveAsMenuItem_Text}" KeyboardAcceleratorTextOverride="{u:Loc Key=CtrlShiftS}" Click="SaveAsMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control,Shift"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutSubItem x:Name="ExportMenu" Text="{u:Loc Key=ExportMenu_Text}">
                    <MenuFlyoutItem x:Name="ExportHtmlMenuItem" Text="{u:Loc Key=ExportHtmlMenuItem_Text}" Click="ExportHtmlMenuItem_Click"/>
                    <MenuFlyoutItem x:Name="ExportPdfMenuItem" Text="{u:Loc Key=ExportPdfMenuItem_Text}" Click="ExportPdfMenuItem_Click"/>
                    <MenuFlyoutItem x:Name="ExportTextMenuItem" Text="{u:Loc Key=ExportTextMenuItem_Text}" Click="ExportTextMenuItem_Click"/>
                </MenuFlyoutSubItem>
                <MenuFlyoutItem x:Name="PrintMenuItem" Text="{u:Loc Key=PrintMenuItem_Text}" Click="PrintMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="P" Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem x:Name="SettingsMenuItem" Text="{u:Loc Key=SettingsMenuItem_Text}" Click="SettingsMenuItem_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem x:Name="ExitMenuItem" Text="{u:Loc Key=ExitMenuItem_Text}" Click="ExitMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="W" Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>
            <MenuBarItem Title="{u:Loc Key=Edit}">
                <!-- Shortcut text only, no KeyboardAccelerator: a XAML accelerator is window-wide and
                     would take Ctrl+Z/Ctrl+A away from the Find and Quick Open text boxes. Inside the
                     editor these keys are caught by HostShortcutScript instead (MainWindow.xaml.cs). -->
                <MenuFlyoutItem x:Name="UndoMenuItem" Text="{u:Loc Key=UndoMenuItem_Text}" Click="UndoMenuItem_Click" IsEnabled="False" KeyboardAcceleratorTextOverride="Ctrl+Z"/>
                <MenuFlyoutItem x:Name="RedoMenuItem" Text="{u:Loc Key=RedoMenuItem_Text}" Click="RedoMenuItem_Click" IsEnabled="False" KeyboardAcceleratorTextOverride="Ctrl+Y"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem x:Name="CopyMenuItem" Text="{u:Loc Key=CopyMenuItem_Text}" Click="CopyMenuItem_Click" KeyboardAcceleratorTextOverride="Ctrl+C"/>
                <MenuFlyoutItem x:Name="PasteMenuItem" Text="{u:Loc Key=PasteMenuItem_Text}" Click="PasteMenuItem_Click" KeyboardAcceleratorTextOverride="Ctrl+V"/>
                <MenuFlyoutItem x:Name="SelectAllMenuItem" Text="{u:Loc Key=SelectAllMenuItem_Text}" Click="SelectAllMenuItem_Click" KeyboardAcceleratorTextOverride="Ctrl+A"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem x:Name="FindMenuItem" Text="{u:Loc Key=FindMenuItem_Text}" Click="FindMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F" Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem x:Name="InsertImageMenuItem" Text="{u:Loc Key=InsertImageMenuItem_Text}" Click="InsertImageMenuItem_Click"/>
                <MenuFlyoutItem x:Name="InsertTableMenuItem" Text="{u:Loc Key=InsertTableMenuItem_Text}" Click="InsertTableMenuItem_Click"/>
            </MenuBarItem>
            <!-- Ported from the original's ParagraphItem.xaml / FormatItem.xaml: same command names
                 (UpdateParagraph / Format parameters). Shortcut text only; the keys are handled in
                 HostShortcutScript/TryHandleFormattingShortcut, since XAML accelerators don't fire
                 while the editor has focus. Disabled in Code/Split (see UpdateViewModeUi). -->
            <MenuBarItem x:Name="ParagraphMenu" Title="{u:Loc Key=ParagraphMenu_Title}">
                <MenuFlyoutItem Text="{u:Loc Key=Heading1}" Tag="p:heading 1" Click="FormatCommand_Click" KeyboardAcceleratorTextOverride="Ctrl+1"/>
                <MenuFlyoutItem Text="{u:Loc Key=Heading2}" Tag="p:heading 2" Click="FormatCommand_Click" KeyboardAcceleratorTextOverride="Ctrl+2"/>
                <MenuFlyoutItem Text="{u:Loc Key=Heading3}" Tag="p:heading 3" Click="FormatCommand_Click" KeyboardAcceleratorTextOverride="Ctrl+3"/>
                <MenuFlyoutItem Text="{u:Loc Key=Heading4}" Tag="p:heading 4" Click="FormatCommand_Click" KeyboardAcceleratorTextOverride="Ctrl+4"/>
                <MenuFlyoutItem Text="{u:Loc Key=Heading5}" Tag="p:heading 5" Click="FormatCommand_Click" KeyboardAcceleratorTextOverride="Ctrl+5"/>
                <MenuFlyoutItem Text="{u:Loc Key=Heading6}" Tag="p:heading 6" Click="FormatCommand_Click" KeyboardAcceleratorTextOverride="Ctrl+6"/>
                <MenuFlyoutItem Text="{u:Loc Key=Paragraph}" Tag="p:paragraph" Click="FormatCommand_Click" KeyboardAcceleratorTextOverride="Ctrl+0"/>
                <MenuFlyoutItem Text="{u:Loc Key=IncreaseHeadingLevel}" Tag="p:upgrade heading" Click="FormatCommand_Click"/>
                <MenuFlyoutItem Text="{u:Loc Key=DecreaseHeadingLevel}" Tag="p:degrade heading" Click="FormatCommand_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="{u:Loc Key=BulletedList}" Tag="p:ul-bullet" Click="FormatCommand_Click"/>
                <MenuFlyoutItem Text="{u:Loc Key=NumberedList}" Tag="p:ol-order" Click="FormatCommand_Click"/>
                <MenuFlyoutItem Text="{u:Loc Key=TaskList}" Tag="p:ul-task" Click="FormatCommand_Click" KeyboardAcceleratorTextOverride="{u:Loc Key=ShortcutCtrlShiftX}"/>
                <MenuFlyoutItem Text="{u:Loc Key=Quote}" Tag="p:blockquote" Click="FormatCommand_Click" KeyboardAcceleratorTextOverride="{u:Loc Key=ShortcutCtrlShiftQ}"/>
                <MenuFlyoutItem Text="{u:Loc Key=CodeBlock}" Tag="p:pre" Click="FormatCommand_Click" KeyboardAcceleratorTextOverride="{u:Loc Key=ShortcutCtrlShiftK}"/>
                <MenuFlyoutItem Text="{u:Loc Key=MathBlock}" Tag="p:mathblock" Click="FormatCommand_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="{u:Loc Key=TableMenu}" Tag="insert:table" Click="FormatCommand_Click" KeyboardAcceleratorTextOverride="{u:Loc Key=ShortcutCtrlShiftT}"/>
                <MenuFlyoutItem Text="{u:Loc Key=HorizontalLine}" Tag="p:hr" Click="FormatCommand_Click"/>
                <MenuFlyoutItem Text="{u:Loc Key=FootnoteMenu}" Tag="p:footnote" Click="FormatCommand_Click"/>
                <MenuFlyoutItem Text="{u:Loc Key=TableOfContents}" Tag="p:toc" Click="FormatCommand_Click"/>
                <MenuFlyoutItem Text="{u:Loc Key=YAMLFrontMatter}" Tag="p:front-matter" Click="FormatCommand_Click"/>
                <MenuFlyoutSubItem Text="{u:Loc Key=Diagram}">
                    <MenuFlyoutItem Text="{u:Loc Key=Mermaid}" Tag="p:mermaid" Click="FormatCommand_Click"/>
                    <MenuFlyoutItem Text="{u:Loc Key=Flowchart}" Tag="p:flowchart" Click="FormatCommand_Click"/>
                    <MenuFlyoutItem Text="{u:Loc Key=SequenceDiagram}" Tag="p:sequence" Click="FormatCommand_Click"/>
                    <MenuFlyoutItem Text="{u:Loc Key=PlantUML}" Tag="p:plantuml" Click="FormatCommand_Click"/>
                    <MenuFlyoutItem Text="{u:Loc Key=VegaLiteChart}" Tag="p:vega-lite" Click="FormatCommand_Click"/>
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="{u:Loc Key=InsertParagraphBefore}" Tag="insert:before" Click="FormatCommand_Click"/>
                <MenuFlyoutItem Text="{u:Loc Key=InsertParagraphAfter}" Tag="insert:after" Click="FormatCommand_Click"/>
            </MenuBarItem>
            <MenuBarItem x:Name="FormatMenu" Title="{u:Loc Key=FormatMenu_Title}">
                <MenuFlyoutItem Text="{u:Loc Key=Bold}" Tag="f:strong" Click="FormatCommand_Click" KeyboardAcceleratorTextOverride="Ctrl+B"/>
                <MenuFlyoutItem Text="{u:Loc Key=Italic}" Tag="f:em" Click="FormatCommand_Click" KeyboardAcceleratorTextOverride="Ctrl+I"/>
                <MenuFlyoutItem Text="{u:Loc Key=Underline}" Tag="f:u" Click="FormatCommand_Click" KeyboardAcceleratorTextOverride="Ctrl+U"/>
                <MenuFlyoutItem Text="{u:Loc Key=Strikethrough}" Tag="f:del" Click="FormatCommand_Click"/>
                <MenuFlyoutItem Text="{u:Loc Key=Highlight}" Tag="f:mark" Click="FormatCommand_Click"/>
                <MenuFlyoutItem Text="{u:Loc Key=InlineCode}" Tag="f:inline_code" Click="FormatCommand_Click"/>
                <MenuFlyoutItem Text="{u:Loc Key=InlineMath}" Tag="f:inline_math" Click="FormatCommand_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="{u:Loc Key=Link}" Tag="f:link" Click="FormatCommand_Click"/>
                <MenuFlyoutItem Text="{u:Loc Key=ImageMenu}" Tag="insert:image" Click="FormatCommand_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="{u:Loc Key=ClearFormatting}" Tag="f:clear" Click="FormatCommand_Click"/>
            </MenuBarItem>
            <MenuBarItem Title="{u:Loc Key=View}">
                <ToggleMenuFlyoutItem x:Name="TocMenuItem" Text="{u:Loc Key=TocMenuItem_Text}" IsChecked="True" Click="TocMenuItem_Click"/>
                <ToggleMenuFlyoutItem x:Name="StatusBarMenuItem" Text="{u:Loc Key=StatusBarMenuItem_Text}" IsChecked="True" Click="StatusBarMenuItem_Click"/>
                <MenuFlyoutSeparator/>
                <RadioMenuFlyoutItem x:Name="ViewModeViewMenuItem" Text="{u:Loc Key=ViewModeViewMenuItem_Text}" GroupName="ViewMode" Tag="view" Click="ViewModeMenuItem_Click"/>
                <RadioMenuFlyoutItem x:Name="ViewModeCodeMenuItem" Text="{u:Loc Key=ViewModeCodeMenuItem_Text}" GroupName="ViewMode" Tag="code" Click="ViewModeMenuItem_Click"/>
                <RadioMenuFlyoutItem x:Name="ViewModeSplitMenuItem" Text="{u:Loc Key=ViewModeSplitMenuItem_Text}" GroupName="ViewMode" Tag="split" Click="ViewModeMenuItem_Click"/>
            </MenuBarItem>
        </MenuBar>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TocColumn" Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Reimplemented, not ported: the original LeftPane split Folder and Contents (TOC) into
                 separate NavigationView-hosted pages (FolderPage/TocPage) switched by a pivot, both
                 bound through a full AppViewModel. This stacks them in one column instead — Folder
                 section only appears once a folder's been opened.
                 Sidebar restructure (Phase 2 of the warm-autumn reskin): New Note button + a nav rail
                 (Home/Recent/Favorites/All Files/Templates/Trash) sit above the existing Folder tree,
                 matching the brand mockups' sidebar. Each nav item swaps in its own small panel (only
                 one visible at a time — see NavListView_SelectionChanged in MainWindow.xaml.cs); "All
                 Files" just reveals the Folder tree below instead of its own panel, since that tree is
                 already the "all files in this folder" view. Icons reuse a couple of the brand's 17
                 starter icons as reasonable stand-ins where there's no exact match (list.svg for
                 Recent, edit.svg for Templates) rather than inventing new glyphs. -->
            <Border Grid.Column="0" x:Name="TocPane" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" x:Name="NewNoteButton" Click="NewMenuItem_Click"
                            Margin="8,8,8,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Background="{ThemeResource CaretPrimaryBrush}" Foreground="White">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Data="M12 5V19M5 12H19" Style="{StaticResource CaretLineIconStyle}" Stroke="White" Width="14" Height="14"/>
                            <TextBlock Text="{u:Loc Key=NewNote}"/>
                        </StackPanel>
                    </Button>

                    <ListView Grid.Row="1" x:Name="NavListView" SelectionMode="Single" SelectionChanged="NavListView_SelectionChanged" Margin="4,0,4,4">
                        <ListViewItem Tag="Home">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Data="M4 11L12 4L20 11V20H15V14H9V20H4Z" Style="{StaticResource CaretLineIconStyle}"/>
                                <TextBlock Text="{u:Loc Key=Home}"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="Convert">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Data="M6 3H13L18 8V21H6Z M13 3V8H18 M9 14L12 17L15 14 M12 10V17" Style="{StaticResource CaretLineIconStyle}"/>
                                <TextBlock Text="{u:Loc Key=ConvertNav}"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="Recent">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Data="M8 6H21M8 12H21M8 18H21M3 6H3.01M3 12H3.01M3 18H3.01" Style="{StaticResource CaretLineIconStyle}"/>
                                <TextBlock Text="{u:Loc Key=Recent}"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="Favorites">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Data="M12 3L14.8 8.7L21 9.6L16.5 14L17.6 20.2L12 17.3L6.4 20.2L7.5 14L3 9.6L9.2 8.7Z" Style="{StaticResource CaretLineIconStyle}"/>
                                <TextBlock Text="{u:Loc Key=Favorites}"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="AllFiles">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Data="M3 6H10L12 8H21V20H3Z" Style="{StaticResource CaretLineIconStyle}"/>
                                <TextBlock Text="{u:Loc Key=AllFiles}"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="Templates">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Data="M4 20L5 15L16 4L20 8L9 19Z M14 6L18 10" Style="{StaticResource CaretLineIconStyle}"/>
                                <TextBlock Text="{u:Loc Key=Templates}"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="Trash">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Data="M5 7H19M9 7V4H15V7M7 7L8 20H16L17 7M10 10V17M14 10V17" Style="{StaticResource CaretLineIconStyle}"/>
                                <TextBlock Text="{u:Loc Key=Trash}"/>
                            </StackPanel>
                        </ListViewItem>
                    </ListView>

                    <!-- Nav content panels — only one Visible at a time, toggled from
                         NavListView_SelectionChanged. Each is populated from code-behind rather than
                         bound, matching this project's existing convention for these lists (see
                         RefreshRecentFilesMenu). -->
                    <StackPanel Grid.Row="2" x:Name="HomePanel" Visibility="Collapsed" Margin="12,4,12,8" Spacing="4">
                        <TextBlock Text="{u:Loc Key=WelcomeToCaret}" FontWeight="SemiBold"/>
                        <TextBlock Text="{u:Loc Key=WritePreviewOrganize}" Opacity="0.7" TextWrapping="Wrap" FontSize="12"/>
                        <Button Click="HomeConvertButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,8,0,0" Padding="10,8">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{u:Loc Key=HomeConvertTitle}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                <TextBlock Text="{u:Loc Key=HomeConvertSubtitle}" FontSize="12" Opacity="0.75" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <ListView Grid.Row="2" x:Name="RecentNavListView" Visibility="Collapsed" MaxHeight="200"
                              ItemTemplate="{StaticResource NavFileEntryTemplate}"
                              IsItemClickEnabled="True" ItemClick="RecentNavListView_ItemClick" SelectionMode="None"/>
                    <Grid Grid.Row="2" x:Name="FavoritesPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" x:Name="FavoritesEmptyText" Text="{u:Loc Key=FavoritesEmptyText_Text}"
                                   Margin="12,4,12,4" Opacity="0.7" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
                        <ListView Grid.Row="1" x:Name="FavoritesNavListView" MaxHeight="200"
                                  ItemTemplate="{StaticResource NavFileEntryTemplate}"
                                  IsItemClickEnabled="True" ItemClick="FavoritesNavListView_ItemClick" SelectionMode="None"/>
                    </Grid>
                    <Grid Grid.Row="2" x:Name="TemplatesPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Content="{u:Loc Key=SaveCurrentDocumentAsTemplate}" Click="SaveAsTemplate_Click"
                                Margin="8,4,8,4" HorizontalAlignment="Stretch" FontSize="12"/>
                        <ListView Grid.Row="1" x:Name="TemplatesNavListView" MaxHeight="200"
                                  ItemTemplate="{StaticResource NavFileEntryTemplate}"
                                  IsItemClickEnabled="True" ItemClick="TemplatesNavListView_ItemClick" SelectionMode="None"/>
                    </Grid>
                    <Grid Grid.Row="2" x:Name="TrashPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" x:Name="TrashEmptyText" Text="{u:Loc Key=TrashEmptyText_Text}"
                                   Margin="12,4,12,4" Opacity="0.7" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
                        <ListView Grid.Row="1" x:Name="TrashNavListView" MaxHeight="200"
                                  ItemTemplate="{StaticResource TrashEntryTemplate}"
                                  IsItemClickEnabled="True" ItemClick="TrashNavListView_ItemClick" SelectionMode="None"/>
                    </Grid>

                    <Border Grid.Row="3" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,0"/>

                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Ported (structurally) from Typedown.Core\Controls\SidePaneControls\Pages\
                             FolderPage.xaml: a real ExplorerItem tree bound the same way — TreeView.
                             ItemsSource is the root item's Children (the root itself is never shown), a
                             DataTemplateSelector swaps between folder/file row templates, each folder
                             row's own ItemsSource is its Children for recursive nesting. Live file-system
                             watching and expand/collapse, drag-drop, and clipboard cut/copy/paste all
                             work now — see MainWindow.xaml.cs. CanDragItems/AllowDrop are deliberately
                             left off the TreeView itself (default false, same as the original): dragging
                             and dropping is handled per-item, on each TreeViewItem in the templates
                             above, not through the TreeView's own built-in same-list reorder. -->
                        <StackPanel Grid.Row="0" x:Name="FolderSection" Visibility="Collapsed">
                            <TextBlock x:Name="FolderHeaderText" Margin="8,8,8,4" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                            <TreeView x:Name="FolderTreeView" MaxHeight="300"
                                      ItemTemplateSelector="{StaticResource ExplorerItemTemplateSelector}"
                                      ItemInvoked="FolderTreeView_ItemInvoked"
                                      ContextFlyout="{StaticResource RootContextFlyout}"/>
                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Reimplemented, not ported: the original LeftPane/TocPage used a nested TreeView
                             bound through EditorViewModel.Toc (an ObservableCollection tree built from the
                             editor's StateChange messages) via a full AppViewModel DataContext. This is a
                             flat, indented ListView fed directly from the same StateChange.toc data over
                             our EventCenter, and it sends the same ScrollTo {slug} message the original's
                             JumpBySlug did — traced from EditorViewModel.cs and confirmed against
                             Muya/index.tsx's ScrollTo listener. -->
                        <ListView Grid.Row="1" x:Name="TocListView" SelectionMode="None" IsItemClickEnabled="True" ItemClick="TocListView_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Content}" Margin="{Binding Indent}" TextTrimming="CharacterEllipsis" FontSize="13"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- New since the fork, not in the original at all: a small decorative footer,
                         matching the brand mockups' sidebar card ("Ideas grow here." over autumn-leaf
                         art). The mockup's own art is a photorealistic lake/mountain scene that isn't
                         actually in the delivered asset package (checked — only flat vector pieces
                         are: leaves/*.svg, decorative/atmosphere/*.svg), so this is composed from
                         those real brand assets instead of approximating a photo: the same leaf
                         silhouette path from leaves/leaf-copper.svg and leaves/leaf-orange.svg (copied
                         verbatim, like CaretLineIconStyle already does for folder/file), at two sizes
                         and rotations, over a soft two-stop gradient using the theme's own surface
                         colors — flat and illustrated, consistent with the rest of the brand pass
                         (UseMicaEffect defaults off for the same reason, see Themes/Caret.xaml). Purely
                         decorative: no click handler, hides with the rest of TocPane when Sidebar is
                         toggled off. -->
                    <Border Grid.Row="5" Margin="8,8,8,10" Padding="12,10" Height="96"
                            CornerRadius="{ThemeResource OverlayCornerRadius}"
                            BorderBrush="{ThemeResource CaretBorderBrush}" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{ThemeResource CaretSurfaceAltColor}" Offset="0"/>
                                <GradientStop Color="{ThemeResource CaretBackgroundColor}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Path Data="M120 330C65 286 29 226 37 160C46 88 99 37 168 22C186 81 180 147 145 204C126 235 106 262 120 330Z"
                                  Fill="{ThemeResource CaretSecondaryBrush}" Opacity="0.55" Stretch="Uniform"
                                  Width="40" Height="60" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="10" CenterX="20" CenterY="30"/>
                                </Path.RenderTransform>
                            </Path>
                            <Path Data="M120 330C65 286 29 226 37 160C46 88 99 37 168 22C186 81 180 147 145 204C126 235 106 262 120 330Z"
                                  Fill="{ThemeResource CaretPrimaryBrush}" Opacity="0.75" Stretch="Uniform"
                                  Width="28" Height="42" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,26,20,0">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="-16" CenterX="14" CenterY="21"/>
                                </Path.RenderTransform>
                            </Path>
                            <TextBlock Text="{u:Loc Key=IdeasGrowHere}" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                       FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="140"
                                       Foreground="{ThemeResource CaretTextPrimaryBrush}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- New since the fork: "a newer Caret is available" (ShowUpdateNotice). Closing it just
                 hides it until the next daily check; "Skip this version" silences that version. -->
            <InfoBar Grid.Row="0" x:Name="UpdateInfoBar" IsOpen="False" Severity="Informational"
                     CornerRadius="0" BorderThickness="0,0,0,1">
                <InfoBar.ActionButton>
                    <Button Content="{u:Loc Key=Download}" Click="UpdateDownload_Click" Style="{StaticResource AccentButtonStyle}"/>
                </InfoBar.ActionButton>
                <HyperlinkButton Content="{u:Loc Key=SkipThisVersion}" Click="UpdateSkip_Click" Margin="-12,-8,0,4" Padding="12,2"/>
            </InfoBar>

            <!-- Formatting toolbar (the mockups' H1 H2 H3 · B I · link · lists · code · table · image
                 row). Every button sends a command the editor (Muya) already handles — Format /
                 UpdateParagraph, the same wire messages the original's Format and Paragraph menus sent
                 (Typedown.Core's FormatViewModel/ParagraphViewModel) — or reuses Insert Table / Insert
                 Image. Hidden in Code/Split, where the source editor doesn't understand these commands. -->
            <Border Grid.Row="1" x:Name="FormatToolbar" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1" Padding="12,3">
                <Border.Resources>
                    <Style x:Key="ToolbarButtonStyle" TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="MinWidth" Value="32"/>
                        <Setter Property="MinHeight" Value="28"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="IsTabStop" Value="False"/>
                    </Style>
                    <Style x:Key="ToolbarSeparatorStyle" TargetType="Border">
                        <Setter Property="Width" Value="1"/>
                        <Setter Property="Margin" Value="6,6"/>
                        <Setter Property="Background" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                    </Style>
                </Border.Resources>
                <StackPanel Orientation="Horizontal" Spacing="1">
                    <Button Style="{StaticResource ToolbarButtonStyle}" Tag="p:heading 1" Click="FormatCommand_Click" ToolTipService.ToolTip="{u:Loc Key=Heading1Ctrl1}" Content="H1" FontWeight="SemiBold"/>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Tag="p:heading 2" Click="FormatCommand_Click" ToolTipService.ToolTip="{u:Loc Key=Heading2Ctrl2}" Content="H2" FontWeight="SemiBold"/>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Tag="p:heading 3" Click="FormatCommand_Click" ToolTipService.ToolTip="{u:Loc Key=Heading3Ctrl3}" Content="H3" FontWeight="SemiBold"/>
                    <Border Style="{StaticResource ToolbarSeparatorStyle}"/>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Tag="f:strong" Click="FormatCommand_Click" ToolTipService.ToolTip="{u:Loc Key=BoldCtrlB}">
                        <TextBlock Text="B" FontWeight="Bold"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Tag="f:em" Click="FormatCommand_Click" ToolTipService.ToolTip="{u:Loc Key=ItalicCtrlI}">
                        <TextBlock Text="I" FontStyle="Italic" FontFamily="Georgia"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Tag="f:del" Click="FormatCommand_Click" ToolTipService.ToolTip="{u:Loc Key=Strikethrough}">
                        <TextBlock Text="S" TextDecorations="Strikethrough"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Tag="f:inline_code" Click="FormatCommand_Click" ToolTipService.ToolTip="{u:Loc Key=InlineCode}" Content="`c`" FontFamily="Consolas"/>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Tag="f:link" Click="FormatCommand_Click" ToolTipService.ToolTip="{u:Loc Key=Link}">
                        <FontIcon Glyph="&#xE71B;" FontSize="14"/>
                    </Button>
                    <Border Style="{StaticResource ToolbarSeparatorStyle}"/>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Tag="p:ul-bullet" Click="FormatCommand_Click" ToolTipService.ToolTip="{u:Loc Key=BulletedList}">
                        <FontIcon Glyph="&#xE8FD;" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Tag="p:ol-order" Click="FormatCommand_Click" ToolTipService.ToolTip="{u:Loc Key=NumberedList}" Content="1."/>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Tag="p:ul-task" Click="FormatCommand_Click" ToolTipService.ToolTip="{u:Loc Key=TaskListCtrlShiftX}">
                        <FontIcon Glyph="&#xE73A;" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Tag="p:blockquote" Click="FormatCommand_Click" ToolTipService.ToolTip="{u:Loc Key=QuoteCtrlShiftQ}" Content="❝" FontSize="16"/>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Tag="p:pre" Click="FormatCommand_Click" ToolTipService.ToolTip="{u:Loc Key=CodeBlockCtrlShiftK}">
                        <FontIcon Glyph="&#xE943;" FontSize="14"/>
                    </Button>
                    <Border Style="{StaticResource ToolbarSeparatorStyle}"/>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Tag="insert:table" Click="FormatCommand_Click" ToolTipService.ToolTip="{u:Loc Key=InsertTableCtrlShiftT}" Content="{u:Loc Key=Table2}"/>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Tag="insert:image" Click="FormatCommand_Click" ToolTipService.ToolTip="{u:Loc Key=InsertImage}">
                        <FontIcon Glyph="&#xEB9F;" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Tag="p:hr" Click="FormatCommand_Click" ToolTipService.ToolTip="{u:Loc Key=HorizontalLine}" Content="—"/>
                </StackPanel>
            </Border>

            <WebView2 Grid.Row="2" x:Name="EditorView"/>

            <!-- Reimplemented, not ported: the original FindReplace.xaml used a ThemeShadow +
                 GridSplitter-resizable floating panel bound through FloatViewModel/EditorViewModel/
                 AppViewModel, none of which exist yet. The actual search/highlight/replace logic
                 lives entirely in the web editor (Muya) already — this panel is just an input bar
                 that speaks the same Search/Find/Replace/SearchOpenChange wire messages the original
                 native side sent, traced from Typedown.Editor/src/components/Muya/index.tsx. -->
            <Border Grid.Row="2" x:Name="FindReplacePanel" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Center"
                    Margin="16" MinWidth="480" Padding="8" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="4">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FindTextBox" PlaceholderText="{u:Loc Key=FindTextBox_Placeholder}" KeyDown="FindTextBox_KeyDown" TextChanged="FindTextBox_TextChanged"/>
                        <Button Grid.Column="1" Content="&#x2193;" Click="FindNext_Click" ToolTipService.ToolTip="{u:Loc Key=FindNext}"/>
                        <Button Grid.Column="2" Content="&#x2191;" Click="FindPrev_Click" ToolTipService.ToolTip="{u:Loc Key=FindPrevious}"/>
                        <Button Grid.Column="3" Content="&#x2715;" Click="CloseFind_Click" ToolTipService.ToolTip="{u:Loc Key=Close}"/>
                    </Grid>
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ReplaceTextBox" PlaceholderText="{u:Loc Key=ReplaceTextBox_Placeholder}"/>
                        <Button Grid.Column="1" Content="{u:Loc Key=Replace}" Click="Replace_Click"/>
                        <Button Grid.Column="2" Content="{u:Loc Key=ReplaceAll}" Click="ReplaceAll_Click"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <CheckBox x:Name="CaseSensitiveCheck" Content="{u:Loc Key=CaseSensitiveCheck_Content}" Checked="SearchOption_Changed" Unchecked="SearchOption_Changed"/>
                        <CheckBox x:Name="WholeWordCheck" Content="{u:Loc Key=WholeWordCheck_Content}" Checked="SearchOption_Changed" Unchecked="SearchOption_Changed"/>
                        <CheckBox x:Name="RegexCheck" Content="{u:Loc Key=RegexCheck_Content}" Checked="SearchOption_Changed" Unchecked="SearchOption_Changed"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- New since the fork: Convert to Markdown (MainWindow.Convert.cs). Covers the toolbar and
                 editor while open; files or folders can be dropped anywhere on it. -->
            <Grid Grid.Row="1" Grid.RowSpan="2" x:Name="ConvertPage" Visibility="Collapsed"
                  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                  AllowDrop="True" DragOver="ConvertPage_DragOver" Drop="ConvertPage_Drop">
                <ScrollViewer>
                    <StackPanel MaxWidth="880" Margin="32,20,32,32" Spacing="18">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Click="ConvertBack_Click" Background="Transparent" BorderThickness="0" Width="36" Height="36" Padding="0"
                                    VerticalAlignment="Center" ToolTipService.ToolTip="{u:Loc Key=ConvertBackToEditor}">
                                <Path Data="M15 5L8 12L15 19" Style="{StaticResource CaretLineIconStyle}" Width="16" Height="16"/>
                            </Button>
                            <TextBlock Grid.Column="1" Text="{u:Loc Key=ConvertTitle}" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{u:Loc Key=ConvertIntro}" TextWrapping="Wrap" Opacity="0.85" FontSize="15" Margin="0,-6,0,0"/>

                        <!-- Drop zone -->
                        <Grid MinHeight="190" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Rectangle x:Name="ConvertDropOutline" Stroke="{ThemeResource CaretPrimaryBrush}" StrokeThickness="1.5" StrokeDashArray="5 4"
                                       RadiusX="12" RadiusY="12" Opacity="0.6"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Padding="24">
                                <Path Data="M6 3H13L18 8V21H6Z M13 3V8H18 M9 14L12 17L15 14 M12 10V17" Style="{StaticResource CaretLineIconStyle}"
                                      Stroke="{ThemeResource CaretPrimaryBrush}" Width="34" Height="34" HorizontalAlignment="Center"/>
                                <TextBlock Text="{u:Loc Key=ConvertDropHere}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <Button Content="{u:Loc Key=ConvertChooseFiles}" Click="ConvertChooseFiles_Click" Style="{StaticResource AccentButtonStyle}"/>
                                    <Button Content="{u:Loc Key=ConvertChooseFolder}" Click="ConvertChooseFolder_Click"/>
                                </StackPanel>
                                <TextBlock Text="{u:Loc Key=ConvertFormats}" FontSize="12" Opacity="0.7" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <!-- Options -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="{u:Loc Key=ConvertSaveTo}"/>
                            <ComboBox x:Name="ConvertOutputComboBox" HorizontalAlignment="Stretch" SelectionChanged="ConvertOutputComboBox_SelectionChanged">
                                <ComboBoxItem Content="{u:Loc Key=ConvertSaveNextTo}" Tag="next"/>
                                <ComboBoxItem x:Name="ConvertOutputFolderItem" Content="{u:Loc Key=ConvertSaveToFolder}" Tag="folder"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Converter: MarkItDown in the user's own Python (MainWindow.MarkItDown.cs) -->
                        <Border CornerRadius="8" Padding="16,12"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{u:Loc Key=EngineTitle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <ProgressRing x:Name="ConvertEngineProgress" IsActive="False" Width="16" Height="16"/>
                                </StackPanel>
                                <TextBlock x:Name="ConvertEngineStatusText" TextWrapping="Wrap"/>
                                <TextBlock x:Name="ConvertEngineDetailText" TextWrapping="Wrap" Opacity="0.7" FontSize="12" IsTextSelectionEnabled="True" Visibility="Collapsed"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="ConvertInstallMarkItDownButton" Content="{u:Loc Key=EngineInstallMarkItDown}" Click="ConvertInstallMarkItDown_Click"
                                            Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed"/>
                                    <Button Content="{u:Loc Key=EngineChoosePython}" Click="ConvertChoosePython_Click"/>
                                    <Button Content="{u:Loc Key=EngineDetectAgain}" Click="ConvertDetectPython_Click"/>
                                    <HyperlinkButton x:Name="ConvertEngineAutomaticButton" Content="{u:Loc Key=EngineUseAutomatic}" Click="ConvertUseAutomaticPython_Click" Visibility="Collapsed"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Summary of this session's conversions -->
                        <Border x:Name="ConvertSummaryPanel" Visibility="Collapsed" CornerRadius="8" Padding="16,12"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid ColumnSpacing="12" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="ConvertSummaryTitle" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="ConvertSummaryDetail" Opacity="0.8" FontSize="13" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button x:Name="ConvertCopyAllButton" Click="ConvertCopyAll_Click" Style="{StaticResource AccentButtonStyle}"
                                            ToolTipService.ToolTip="{u:Loc Key=ConvertCopyAllTip}">
                                        <TextBlock x:Name="ConvertCopyAllText" Text="{u:Loc Key=ConvertCopyAll}"/>
                                    </Button>
                                    <Button Content="{u:Loc Key=ConvertClear}" Click="ConvertClear_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ListView x:Name="ConvertResultsList" SelectionMode="None" IsItemClickEnabled="False" Padding="0">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="12,10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="46" Height="30" CornerRadius="4" Background="{Binding BadgeBrush}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="11" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ToolTip="{Binding SourcePath}"/>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <ProgressRing IsActive="{Binding IsConverting}" Visibility="{Binding ProgressVisibility}" Width="12" Height="12"/>
                                                    <TextBlock Text="{Binding Detail}" FontSize="12" Opacity="0.8" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Visibility="{Binding ActionsVisibility}" VerticalAlignment="Center">
                                                <Button Content="{u:Loc Key=Open}" Click="ConvertOpenResult_Click" Tag="{Binding}"/>
                                                <Button Content="{u:Loc Key=Copy}" Click="ConvertCopyResult_Click" Tag="{Binding}"/>
                                                <Button Click="ConvertRevealResult_Click" Tag="{Binding}" Padding="8,5"
                                                        ToolTipService.ToolTip="{u:Loc Key=RevealInFileExplorer}">
                                                    <Path Data="M3 6H10L12 8H21V20H3Z" Style="{StaticResource CaretLineIconStyle}" Width="14" Height="14"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Why Markdown -->
                        <Border CornerRadius="12" Padding="20,16" BorderBrush="{ThemeResource CaretBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{u:Loc Key=ConvertWhyTitle}" FontWeight="SemiBold" FontSize="15"/>
                                <Grid ColumnSpacing="16" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{u:Loc Key=ConvertWhyTokensTitle}" FontWeight="SemiBold" Foreground="{ThemeResource CaretPrimaryBrush}"/>
                                        <TextBlock Text="{u:Loc Key=ConvertWhyTokensText}" TextWrapping="Wrap" FontSize="13" Opacity="0.85"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="{u:Loc Key=ConvertWhyStructureTitle}" FontWeight="SemiBold" Foreground="{ThemeResource CaretPrimaryBrush}"/>
                                        <TextBlock Text="{u:Loc Key=ConvertWhyStructureText}" TextWrapping="Wrap" FontSize="13" Opacity="0.85"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <TextBlock Text="{u:Loc Key=ConvertWhyPrivateTitle}" FontWeight="SemiBold" Foreground="{ThemeResource CaretPrimaryBrush}"/>
                                        <TextBlock Text="{u:Loc Key=ConvertWhyPrivateText}" TextWrapping="Wrap" FontSize="13" Opacity="0.85"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            </Grid>
        </Grid>

        <!-- New since the fork: a status bar, matching the brand mockups' bottom bar. The original
             WPF app's own StatusBar.xaml (Typedown.Core\Controls\EditorControls\StatusBar.xaml) is the
             real reference for what's shown here, not the mockup art — the mockup's literal "Ln 18,
             Col 1" isn't reproducible against Muya (a block-based WYSIWYG editor with no line/column
             concept; that only exists in the CodeMirror source view, which isn't wired up as a real
             editing mode here — see docs/history.md's Known Issues). The word/character count toggle is
             real, sourced from the same StateChange wordCount payload TocListView's table of contents
             already reads (UpdateWordCount, subscribed alongside UpdateToc). -->
        <Border Grid.Row="3" x:Name="StatusBar" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="StatusBarFormatText" Text="{u:Loc Key=Markdown}" FontSize="12" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Button Grid.Column="1" x:Name="StatusBarWordCountButton" Click="StatusBarWordCountButton_Click"
                        Background="Transparent" BorderThickness="0" Padding="6,2" FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Content="{u:Loc Key=StatusBarWordCountButton_Content}" ToolTipService.ToolTip="{u:Loc Key=StatusBarWordCountButton_ToolTip}"/>
            </Grid>
        </Border>

        <!-- New since the fork, not in the original at all: a VS Code-style "Go to File" quick open
             (Ctrl+K, the search icon in the title bar, or File > Go to File...). Positioned with
             Grid.Row="0" Grid.RowSpan="3" so it overlays the whole window, not just the editor pane
             (unlike FindReplacePanel above, which only needs to sit over the editor). Candidate list is
             every markdown file under the open folder (QuickOpenAllFiles, built in ShowQuickOpen),
             falling back to Recent Files when no folder is open — filtered client-side as you type
             rather than a real fuzzy-match algorithm, which is enough for a project-sized file list. -->
        <Border x:Name="QuickOpenPanel" Visibility="Collapsed" Grid.Row="0" Grid.RowSpan="3"
                VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,80,0,0"
                MinWidth="480" MaxWidth="560" Padding="8" CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Spacing="4">
                <TextBox x:Name="QuickOpenTextBox" PlaceholderText="{u:Loc Key=QuickOpenTextBox_Placeholder}"
                         TextChanged="QuickOpenTextBox_TextChanged" KeyDown="QuickOpenTextBox_KeyDown"/>
                <!-- Tapped, not ItemClick: ItemClick is documented as the SelectionMode="None" pattern
                     (Single selection is meant to be read via SelectionChanged/SelectedItem instead).
                     Single selection is kept for arrow-key highlight tracking (MoveQuickOpenSelection)
                     and Enter-to-open (SelectedItem) — Tapped fires on every click regardless of
                     whether that click changes the selection (e.g. clicking the already-selected first
                     result, the common case since a result is always pre-selected as you type), which
                     ItemClick is not guaranteed to under Single selection. -->
                <ListView x:Name="QuickOpenListView" MaxHeight="360" SelectionMode="Single"
                          ItemTemplate="{StaticResource NavFileEntryTemplate}" Tapped="QuickOpenListView_Tapped"/>
            </StackPanel>
        </Border>

        <!-- Reimplemented, not ported: the original SettingsPage was a NavigationView + Frame with
             separate pages (General/Editor/Export/Image/Shortcut/Upload/About/View) built from custom
             ExpanderSettingItem/NormalSettingItem/PathPickerButton controls we don't have. This is one
             ContentDialog covering the settings most worth having now — real values, real persistence
             via SettingsViewModel, and FontSize/LineHeight/TabSize/EditorAreaWidth push live to the
             editor through the same SettingsChanged mechanism the original used (they're in
             SettingsViewModel's notifySet). Export/Image/Shortcut/Upload settings are still TODO —
             they need ExportConfig/ImageUploadConfig/shortcut infrastructure that isn't ported yet. -->
        <ContentDialog x:Name="SettingsDialog" Title="{u:Loc Key=SettingsDialog_Title}" PrimaryButtonText="{u:Loc Key=SettingsDialog_Primary}" DefaultButton="Primary">
            <ScrollViewer MaxHeight="420">
                <StackPanel Spacing="16" MinWidth="360">
                    <!-- New since the fork: the app's language (Utilities/Locale.cs). Applied on the next
                         start, because the window's text is resolved as it loads. Language names are
                         written in their own language, so anyone can find theirs. -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{u:Loc Key=Language}"/>
                        <ComboBox x:Name="LanguageComboBox" SelectionChanged="LanguageComboBox_SelectionChanged" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="{u:Loc Key=UseSystemLanguage}" Tag="default"/>
                            <ComboBoxItem Content="English" Tag="en"/>
                            <ComboBoxItem Content="Français" Tag="fr"/>
                            <ComboBoxItem Content="Español" Tag="es"/>
                        </ComboBox>
                        <TextBlock x:Name="LanguageRestartText" Text="{u:Loc Key=LanguageRestartNote}" Visibility="Collapsed"
                                   TextWrapping="Wrap" Opacity="0.7" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{u:Loc Key=Theme}"/>
                        <ComboBox x:Name="ThemeComboBox" SelectionChanged="ThemeComboBox_SelectionChanged" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="{u:Loc Key=UseSystemSetting}" Tag="Default"/>
                            <ComboBoxItem Content="{u:Loc Key=Light}" Tag="Light"/>
                            <ComboBoxItem Content="{u:Loc Key=Dark}" Tag="Dark"/>
                        </ComboBox>
                    </StackPanel>
                    <ToggleSwitch OnContent="{u:Loc Key=ToggleOn}" OffContent="{u:Loc Key=ToggleOff}" x:Name="AutoSaveToggle" Header="{u:Loc Key=AutoSaveToggle_Header}" Toggled="AutoSaveToggle_Toggled"/>
                    <ToggleSwitch OnContent="{u:Loc Key=ToggleOn}" OffContent="{u:Loc Key=ToggleOff}" x:Name="AnimationToggle" Header="{u:Loc Key=AnimationToggle_Header}" Toggled="AnimationToggle_Toggled"/>
                    <ToggleSwitch OnContent="{u:Loc Key=ToggleOn}" OffContent="{u:Loc Key=ToggleOff}" x:Name="UseMicaToggle" Header="{u:Loc Key=UseMicaToggle_Header}" Toggled="UseMicaToggle_Toggled"/>
                    <ToggleSwitch OnContent="{u:Loc Key=ToggleOn}" OffContent="{u:Loc Key=ToggleOff}" x:Name="UseEditorMicaToggle" Header="{u:Loc Key=UseEditorMicaToggle_Header}" Toggled="UseEditorMicaToggle_Toggled"/>
                    <ToggleSwitch OnContent="{u:Loc Key=ToggleOn}" OffContent="{u:Loc Key=ToggleOff}" x:Name="SpellcheckToggle" Header="{u:Loc Key=SpellcheckToggle_Header}" Toggled="SpellcheckToggle_Toggled"
                                  ToolTipService.ToolTip="{u:Loc Key=SpellcheckToggle_ToolTip}"/>
                    <!-- New since the fork: settings.Topmost was another dormant ported setting — the
                         original bound a ToggleSwitch straight to it (Typedown.Core's ViewSetting.xaml)
                         with no other code visible, so the actual "make the window stay on top" behavior
                         must have lived in whatever the original's WPF/XAML-Islands host window did with
                         it — not reproducible directly, but the intent (keep this window pinned above
                         others) maps directly onto OverlappedPresenter.IsAlwaysOnTop. -->
                    <ToggleSwitch OnContent="{u:Loc Key=ToggleOn}" OffContent="{u:Loc Key=ToggleOff}" x:Name="TopmostToggle" Header="{u:Loc Key=TopmostToggle_Header}" Toggled="TopmostToggle_Toggled"/>
                    <!-- InsertClipboardImageAction: None (the original's default) saves pasted images to
                         DefaultImageBasePath (Pictures\Caret); CopyToPath saves them to
                         InsertClipboardImageCopyPath (./images) next to the note. Upload has no backing
                         service in this port, so it isn't offered. -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{u:Loc Key=SavePastedImagesTo}"/>
                        <ComboBox x:Name="PastedImageLocationComboBox" HorizontalAlignment="Stretch" SelectionChanged="PastedImageLocationComboBox_SelectionChanged">
                            <ComboBoxItem Content="{u:Loc Key=PicturesCaret}" Tag="None"/>
                            <ComboBoxItem Content="{u:Loc Key=AnImagesFolderNextToThe}" Tag="CopyToPath"/>
                        </ComboBox>
                    </StackPanel>
                    <!-- New since the fork: FileStartupAction/FolderStartupAction were dormant ported
                         settings (SettingsViewModel.cs) with no UI to ever change them from their
                         defaults — FolderStartupAction defaults to OpenLast, so wiring the logic without
                         this would've silently started reopening everyone's last folder with no way to
                         turn it off short of hand-editing Settings.json. -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{u:Loc Key=OnStartupOpen}"/>
                        <ComboBox x:Name="FileStartupActionComboBox" HorizontalAlignment="Stretch" SelectionChanged="FileStartupActionComboBox_SelectionChanged">
                            <ComboBoxItem Content="{u:Loc Key=ANewBlankNote}" Tag="None"/>
                            <ComboBoxItem Content="{u:Loc Key=TheLastFileYouHadOpen}" Tag="OpenLast"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{u:Loc Key=Folder}"/>
                        <ComboBox x:Name="FolderStartupActionComboBox" HorizontalAlignment="Stretch" SelectionChanged="FolderStartupActionComboBox_SelectionChanged">
                            <ComboBoxItem Content="{u:Loc Key=DonTReopenAFolder}" Tag="None"/>
                            <ComboBoxItem Content="{u:Loc Key=TheLastFolderYouHadOpen}" Tag="OpenLast"/>
                            <ComboBoxItem Content="{u:Loc Key=AlwaysThisFolder}" Tag="OpenFolder"/>
                        </ComboBox>
                        <Grid x:Name="StartupFolderPickerGrid" ColumnSpacing="8" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="StartupOpenFolderBox" IsReadOnly="True"/>
                            <Button Grid.Column="1" Content="{u:Loc Key=Browse}" Click="StartupOpenFolderBrowse_Click"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{u:Loc Key=FontSize}"/>
                        <NumberBox x:Name="FontSizeBox" SpinButtonPlacementMode="Inline" SmallChange="1" Minimum="8" Maximum="72" ValueChanged="FontSizeBox_ValueChanged"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{u:Loc Key=LineHeight}"/>
                        <NumberBox x:Name="LineHeightBox" SpinButtonPlacementMode="Inline" SmallChange="0.1" Minimum="1" Maximum="3" ValueChanged="LineHeightBox_ValueChanged"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{u:Loc Key=TabSize}"/>
                        <NumberBox x:Name="TabSizeBox" SpinButtonPlacementMode="Inline" SmallChange="1" Minimum="1" Maximum="16" ValueChanged="TabSizeBox_ValueChanged"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{u:Loc Key=EditorAreaWidthCSSValueE}"/>
                        <TextBox x:Name="EditorAreaWidthBox" TextChanged="EditorAreaWidthBox_TextChanged"/>
                    </StackPanel>

                    <!-- Reimplemented, not ported: the original's ShortcutPage let you rebind every
                         command (Typedown.Core\Pages\SettingPages\ShortcutPage.xaml, backed by ~60
                         ShortcutKey settings in SettingsViewModel.Shortcut.cs). None of that made this
                         port — the settings themselves were never carried over, and most of what they'd
                         rebind (paragraph/format commands) isn't wired to any host-side shortcut here
                         to begin with, since the editor has no shortcut/keymap concept of its own
                         (confirmed: no "shortcut"/"keymap" reference anywhere in Typedown.Editor's TS
                         source) — those bindings were always native-side in the original, same as
                         Caret's own. A rebinding UI for commands that don't have a binding to rebind
                         would be actively misleading, so this is a plain read-only reference of the
                         shortcuts that actually exist today, kept in sync by hand with the
                         KeyboardAccelerators above and in the File/Edit menus rather than generated. -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{u:Loc Key=KeyboardShortcuts}" FontWeight="SemiBold"/>
                        <Grid ColumnSpacing="12" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{u:Loc Key=New}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{u:Loc Key=CtrlN}" Opacity="0.7"/>
                            <TextBlock Grid.Row="1" Text="{u:Loc Key=NewWindow}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{u:Loc Key=CtrlShiftN}" Opacity="0.7"/>
                            <TextBlock Grid.Row="2" Text="{u:Loc Key=Open}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{u:Loc Key=CtrlO}" Opacity="0.7"/>
                            <TextBlock Grid.Row="3" Text="{u:Loc Key=GoToFile}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{u:Loc Key=CtrlK}" Opacity="0.7"/>
                            <TextBlock Grid.Row="4" Text="{u:Loc Key=Save}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{u:Loc Key=CtrlS}" Opacity="0.7"/>
                            <TextBlock Grid.Row="5" Text="{u:Loc Key=SaveAs}"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{u:Loc Key=CtrlShiftS}" Opacity="0.7"/>
                            <TextBlock Grid.Row="6" Text="{u:Loc Key=Print}"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{u:Loc Key=CtrlP}" Opacity="0.7"/>
                            <TextBlock Grid.Row="7" Text="{u:Loc Key=FindReplace}"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{u:Loc Key=CtrlF}" Opacity="0.7"/>
                            <TextBlock Grid.Row="8" Text="{u:Loc Key=CloseWindow}"/>
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{u:Loc Key=CtrlW}" Opacity="0.7"/>
                        </Grid>
                        <TextBlock Text="{u:Loc Key=StandardTextEditingUndoRedoCut}"
                                   TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="{u:Loc Key=About}" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock x:Name="AboutAppNameText"/>
                            <TextBlock x:Name="AboutAppVersionText" Opacity="0.7"/>
                        </StackPanel>
                        <TextBlock Text="{u:Loc Key=AMarkdownEditorForkedFromTypedown}" TextWrapping="Wrap"/>
                        <HyperlinkButton Content="{u:Loc Key=ViewSourceOnGitHub}" NavigateUri="https://github.com/fegyenc/Caret" Margin="-12,0,0,0"/>
                        <HyperlinkButton Content="{u:Loc Key=ThirdPartyNotices}" NavigateUri="https://github.com/fegyenc/Caret/blob/main/THIRD-PARTY-NOTICES.md" Margin="-12,-8,0,0"/>
                        <!-- Hidden in a Store install, where the Store delivers updates (Config.IsStoreInstall). -->
                        <StackPanel x:Name="UpdateSettingsPanel" Spacing="4">
                            <ToggleSwitch OnContent="{u:Loc Key=ToggleOn}" OffContent="{u:Loc Key=ToggleOff}" x:Name="CheckForUpdatesToggle" Header="{u:Loc Key=CheckForUpdatesToggle_Header}" Toggled="CheckForUpdatesToggle_Toggled" Margin="0,8,0,0"/>
                            <TextBlock Text="{u:Loc Key=OnceADayCaretAsksGitHub}"
                                       TextWrapping="Wrap" Opacity="0.7" FontSize="12"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                <Button x:Name="CheckUpdatesNowButton" Content="{u:Loc Key=CheckUpdatesNowButton_Content}" Click="CheckUpdatesNow_Click"/>
                                <ProgressRing x:Name="CheckUpdatesProgress" IsActive="False" Width="16" Height="16"/>
                                <TextBlock x:Name="CheckUpdatesStatusText" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="260"/>
                            </StackPanel>
                            <HyperlinkButton x:Name="CheckUpdatesDownloadLink" Visibility="Collapsed" Click="UpdateDownload_Click" Margin="-12,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="StoreUpdatesText" Text="{u:Loc Key=StoreUpdatesNote}" Visibility="Collapsed"
                                   TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="0,8,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>

        <!-- Reused for New File / New Folder / Rename in the folder tree's context menu — one TextBox
             ContentDialog rather than the original's inline TreeViewItem-embedded rename TextBox
             (FindName-swapping a TextBlock for a TextBox inside a recycled DataTemplate is fragile
             without x:Bind's named-element guarantees this project doesn't use). Title/PrimaryButtonText
             and the TextBox's starting text are set from code before ShowAsync. -->
        <ContentDialog x:Name="TextInputDialog" PrimaryButtonText="{u:Loc Key=TextInputDialog_Primary}" CloseButtonText="{u:Loc Key=TextInputDialog_Close}" DefaultButton="Primary">
            <TextBox x:Name="TextInputBox" AcceptsReturn="False"/>
        </ContentDialog>

        <!-- New since the fork: the original had PdfPrintSettings (Typedown.Core\Models\RuntimeModels
             \ExportPdfSettings.cs) as C# state but no host UI ever reached in this fork's port that let
             a user actually set them — Export > PDF just called PrintToPdfAsync(path, null) straight
             through, silently taking every CoreWebView2PrintSettings default. One of those defaults is
             a real, concrete gap for a markdown app specifically: ShouldPrintBackgrounds defaults to
             false, so every PDF export so far has been dropping code-block background tints and any
             other background-color styling without anyone asking it to. Margins and header/footer text
             aren't exposed here — WebView2's own defaults for those are reasonable and customizing them
             adds surface area without a concrete gap driving it, unlike backgrounds/orientation/size. -->
        <ContentDialog x:Name="PdfExportOptionsDialog" Title="{u:Loc Key=PdfExportOptionsDialog_Title}" PrimaryButtonText="{u:Loc Key=PdfExportOptionsDialog_Primary}" CloseButtonText="{u:Loc Key=PdfExportOptionsDialog_Close}" DefaultButton="Primary">
            <StackPanel Spacing="16" MinWidth="300">
                <StackPanel Spacing="4">
                    <TextBlock Text="{u:Loc Key=Orientation}"/>
                    <ComboBox x:Name="PdfOrientationComboBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                        <ComboBoxItem Content="{u:Loc Key=Portrait}"/>
                        <ComboBoxItem Content="{u:Loc Key=Landscape}"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="{u:Loc Key=PageSize}"/>
                    <ComboBox x:Name="PdfPageSizeComboBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                        <ComboBoxItem Content="{u:Loc Key=Letter85X11In}"/>
                        <ComboBoxItem Content="{u:Loc Key=A4827X1169}"/>
                        <ComboBoxItem Content="{u:Loc Key=Legal85X14In}"/>
                    </ComboBox>
                </StackPanel>
                <ToggleSwitch x:Name="PdfBackgroundsToggle" Header="{u:Loc Key=PdfBackgroundsToggle_Header}" IsOn="True"
                              OnContent="{u:Loc Key=ToggleOn}" OffContent="{u:Loc Key=ToggleOff}"/>
                <ToggleSwitch x:Name="PdfHeaderFooterToggle" Header="{u:Loc Key=PdfHeaderFooterToggle_Header}" IsOn="False"
                              OnContent="{u:Loc Key=ToggleOn}" OffContent="{u:Loc Key=ToggleOff}"/>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Window>
